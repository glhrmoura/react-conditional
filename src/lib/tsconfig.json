{
  "include": ["./**/*"],
  "exclude": [
    "../dev",
    "../../dist",
    "../../node_modules"
  ],
  "compilerOptions": {
    "jsx": "react",
    "module": "esnext",
    "rootDir": "./",
    "outDir": "../../dist",
    "importHelpers": true,
    "lib": ["dom", "esnext"],
    "esModuleInterop": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
